{
  "name": "western-water-dashboard",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite --open /",
    "build": "tsc --noEmit && vitest run && npm run budget:sdk && vite build",
    "verify:fast": "tsc --noEmit && vitest run",
    "verify:frontend": "npm run build",
    "verify:pipeline": "scripts/verify-pipeline.sh -q",
    "verify:worker": "tsc -p worker/tsconfig.json && vitest run worker/test",
    "verify:browser": "scripts/verify-browser.sh",
    "verify:all": "npm run verify:frontend && npm run verify:pipeline && npm run verify:worker && npm run verify:browser",
    "budget:sdk": "node scripts/check-sdk-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs",
    "smoke:modern": "node tests/smoke-modern.mjs",
    "boundary:utah": "node scripts/fetch-utah-boundary.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@arcgis/charts-components": "^5.1.27",
    "@arcgis/common-components": "^5.1.27",
    "@arcgis/core": "^5.1.27",
    "@arcgis/map-components": "^5.1.27",
    "@esri/calcite-components": "~5.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
